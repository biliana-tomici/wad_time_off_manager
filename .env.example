# ========================================================
# Time Off Manager — Production Environment Variables
# Copy this file to .env on your EC2 instance: cp .env.example .env
# ========================================================

# --- Networking ---
FRONTEND_PORT=80

# --- Database (AWS RDS PostgreSQL) ---
# Replace <rds-endpoint> with your actual RDS endpoint from AWS Console:
# e.g. jdbc:postgresql://timeoff-db.c12345678.eu-central-1.rds.amazonaws.com:5432/timeoff
SPRING_DATASOURCE_URL=jdbc:postgresql://<rds-endpoint>:5432/timeoff
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YourSecureRdsPassword123!

# --- Security & JWT ---
# Provide a random string of at least 32 characters (256-bit)
JWT_SECRET=replace-with-a-random-secret-key-at-least-256-bits-long-prod-2026
JWT_EXPIRATION_MS=28800000

# Optional CORS: empty string allows same-origin via Nginx reverse proxy
CORS_ALLOWED_ORIGINS=

# --- AWS SES (Simple Email Service) / SMTP Settings ---
# SES SMTP Endpoint: e.g. email-smtp.eu-central-1.amazonaws.com
MAIL_HOST=email-smtp.eu-central-1.amazonaws.com
MAIL_PORT=587
# Generate SMTP credentials in AWS Console -> SES -> SMTP Settings
MAIL_USERNAME=YOUR_AWS_SES_SMTP_USERNAME
MAIL_PASSWORD=YOUR_AWS_SES_SMTP_PASSWORD
MAIL_ENABLED=true
MAIL_FROM=no-reply@yourverifieddomain.com

# Frontend public URL for password reset links sent via email
FRONTEND_URL=http://<YOUR_EC2_PUBLIC_IP_OR_DOMAIN>

# --- Initial Admin Account Bootstrapping ---
# Created automatically on first boot when database is empty
APP_ADMIN_EMAIL=alice.smith@timeoff.com
APP_ADMIN_PASSWORD=password123
APP_ADMIN_FIRST_NAME=Alice
APP_ADMIN_LAST_NAME=Smith
